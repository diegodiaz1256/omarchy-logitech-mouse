#!/usr/bin/env python3
"""Battery of a Logitech mouse, read from Solaar, as one line of JSON.

Usage: mouse-battery [--device NAME] [--notify-below PERCENT]

Reads `solaar show NAME` (read only: it never writes Solaar's or Piper's
configuration). Prints {"ok", "online", "name", "percent", "level", "status",
"charging", "last_seen", "error", "notified"}. The last good reading is kept in
$XDG_STATE_HOME/omarchy-logitech-mouse/state.json, so a mouse that is switched
off can still show when it was last heard from.

With --notify-below, one desktop notification is sent when the battery drops to
that percentage while not charging. It re-arms once the battery has climbed 5
points above the threshold or starts charging.
"""
import json
import os
import re
import subprocess
import sys
import time

DEFAULT_DEVICE = "G502"
SOLAAR_TIMEOUT = 20
LEVELS = {"full": 100, "good": 70, "low": 15, "critical": 5}
CHARGING_STATUSES = ("RECHARGING", "SLOW_RECHARGE", "CHARGING")


def state_path():
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(base, "omarchy-logitech-mouse", "state.json")


def load_state():
    try:
        with open(state_path()) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_state(state):
    path = state_path()
    try:
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(state, f)
        os.replace(tmp, path)
    except OSError:
        pass


def parse(text):
    """Turn `solaar show` output into a reading. Pure, so it can be tested."""
    name = ""
    for line in text.splitlines():
        if not line.strip() or line.lower().startswith(("solaar", "rules", "warning")):
            continue
        # Over a cable the device name starts the output; through a receiver it
        # is an indented "  1: NAME" entry.
        paired = re.match(r"^\s{0,4}\d+:\s+(\S.*)$", line)
        if paired:
            name = paired.group(1).strip()
            break
        if not line[0].isspace():
            name = line.strip()
            break
    if not name:
        found = re.search(r"^\s*(?:Codename|Name)\s*:\s*(\S.*)$", text, re.M)
        name = found.group(1).strip() if found else ""
    battery = re.search(r"^\s*Battery:\s*(.+)$", text, re.M)
    reading = {"name": name, "percent": None, "level": "", "status": "", "charging": False}
    if not battery:
        return reading
    line = battery.group(1)
    pct = re.search(r"(\d{1,3})\s*%", line)
    if pct:
        reading["percent"] = min(100, int(pct.group(1)))
    else:
        word = re.search(r"\b(full|good|low|critical)\b", line, re.I)
        if word:
            reading["level"] = word.group(1).lower()
            reading["percent"] = LEVELS[reading["level"]]
    status = re.search(r"BatteryStatus\.([A-Z_]+)", line)
    if status:
        reading["status"] = status.group(1).lower()
    # Exact match: "DISCHARGING" contains "CHARGING".
    reading["charging"] = reading["status"].upper() in CHARGING_STATUSES or \
        bool(re.search(r"(?<!dis)\bcharging\b", line, re.I))
    return reading


def notify(percent, name):
    summary = "Mouse battery low"
    body = "%s is at %d%%. Plug it in soon." % (name or "Mouse", percent)
    subprocess.run(
        ["busctl", "--user", "--", "call", "org.freedesktop.Notifications",
         "/org/freedesktop/Notifications", "org.freedesktop.Notifications", "Notify",
         "susssasa{sv}i", "Logitech Mouse", "0", "", summary, body, "0",
         "2", "urgency", "y", "2", "omarchy-glyph", "s", "\U000f0083", "-1"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10, check=False)


def decide_notify(state, reading, threshold):
    """True once per low episode. Mutates state['low_notified']."""
    pct = reading["percent"]
    if pct is None or threshold <= 0:
        return False
    if reading["charging"] or pct > threshold + 5:
        state["low_notified"] = False
        return False
    if pct <= threshold and not state.get("low_notified"):
        state["low_notified"] = True
        return True
    return False


def main(argv):
    device, threshold = DEFAULT_DEVICE, 0
    args = iter(argv)
    for a in args:
        if a == "--device":
            device = next(args, device) or DEFAULT_DEVICE
        elif a == "--notify-below":
            try:
                threshold = int(next(args, "0"))
            except ValueError:
                threshold = 0
    out = {"ok": False, "online": False, "name": "", "percent": None, "level": "", "status": "",
           "charging": False, "last_seen": 0, "error": "", "notified": False}
    state = load_state()
    try:
        proc = subprocess.run(["solaar", "show", device], capture_output=True, text=True,
                              timeout=SOLAAR_TIMEOUT)
        text = proc.stdout
        err = proc.stderr
    except FileNotFoundError:
        out["error"] = "solaar is not installed"
        text = err = ""
    except subprocess.TimeoutExpired:
        out["error"] = "solaar did not answer"
        text = err = ""
    if not out["error"]:
        reading = parse(text)
        if "No supported device found" in err:
            out["error"] = "no receiver or mouse connected"
        elif "no device found" in err or (not reading["name"] and reading["percent"] is None):
            out["error"] = "no device matching '%s'" % device
        elif reading["percent"] is None:
            out["ok"] = True
            out["name"] = reading["name"]
            out["error"] = "mouse is off or out of range"
        else:
            out.update(reading)
            out["ok"] = out["online"] = True
            out["last_seen"] = int(time.time())
            if decide_notify(state, reading, threshold):
                notify(reading["percent"], reading["name"])
                out["notified"] = True
            state["last"] = {k: reading[k] for k in ("name", "percent", "level", "status", "charging")}
            state["last"]["ts"] = out["last_seen"]
            save_state(state)
    if not out["online"] and isinstance(state.get("last"), dict):
        last = state["last"]
        out["name"] = out["name"] or str(last.get("name", ""))
        out["percent"] = last.get("percent")
        out["charging"] = bool(last.get("charging"))
        out["last_seen"] = int(last.get("ts", 0) or 0)
    # Heartbeat: proof that the poll ran, and what it saw, even when offline.
    state["poll"] = {"ts": int(time.time()), "online": out["online"], "error": out["error"]}
    save_state(state)
    print(json.dumps(out))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
